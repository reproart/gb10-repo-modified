@@ -132,6 +132,12 @@ void ggml_cuda_mul_mat_f(ggml_backend_cuda_context & ctx, const ggml_tensor * sr
 
 bool ggml_cuda_should_use_mmf(enum ggml_type type, int cc, int warp_size, const int64_t * src0_ne,
         const size_t * src0_nb, const int src1_ncols, bool mul_mat_id) {
+    // F32 MMF uses TF32 instructions. Disable it for strict F32 diagnostics.
+    const char * disable_f32_mmf = getenv("GGML_CUDA_MMF_F32_DISABLE");
