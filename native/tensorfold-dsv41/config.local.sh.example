# shellcheck shell=bash disable=SC2034
# The values of your own pair of Sparks. Copy it next to itself and edit:
#   cp config.local.sh.example config.local.sh
# config.sh reads it first; it is not committed (.gitignore). Keep the
# NAME="${NAME:-value}" form, so a value set in the shell still wins. Every
# other setting is in config.sh, with its default and why.
# The names come from (on each node): ibdev2netdev, ip -br addr, show_gids.

# The CX7 link: static IPv4, one subnet (NVIDIA's "Connect Two Sparks").
HEAD_IP="${HEAD_IP:-10.100.80.1}"
WORKER_IP="${WORKER_IP:-10.100.80.2}"
WORKER_SSH="${WORKER_SSH:-10.100.80.2}"       # user@host or an ssh alias work too

# RoCE devices of both CX7 ports, and the netdev that holds HEAD_IP.
RDMA_DEVICES="${RDMA_DEVICES:-rocep1s0f1,roceP2p1s0f1}"
NCCL_SOCKET_IFNAME="${NCCL_SOCKET_IFNAME:-enp1s0f1np1}"
GID_INDEX="${GID_INDEX:-3}"                     # -1 after a link flap moved it (docs/NETWORK.md)

# Where the two weight folders live on both nodes, if not the /models/... defaults;
# or MODEL_VIEW=<folder> for the recipe's layout (model/ and engram/ in one folder).
# MODEL_DIR="${MODEL_DIR:-/models/LibertAIDAI/DeepSeek-V4.1-Flash-1017-EXL3-2.9bpw}"
# ENGRAM_DIR="${ENGRAM_DIR:-/models/deepseek-ai/DeepSeek-V4.1-Flash-1017-engram}"

# An API key for LAN use (a file, one key per line).
# API_KEY_FILE="${API_KEY_FILE:-$HOME/.tfv41-api-keys}"
