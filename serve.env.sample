# Settings for scripts/serve.sh, scripts/01-install.sh and the systemd unit.
#   cp serve.env.sample serve.env     # serve.env is gitignored
# Plain KEY=VALUE lines. Variables set in the shell win over this file;
# anything left out falls back to the default shown.

# Target checkpoint: fp8 (Qwen/Qwen3.8-27B-FP8) | nvfp4 (RadixArk) | custom
#TARGET=fp8
# With TARGET=custom, or to move a preset to another commit:
#TARGET_PATH=
#TARGET_REV=

# DFlash2 draft
#DRAFT_PATH=z-lab/Qwen3.8-27B-DFlash2
#DRAFT_REV=50307d4c4cde6860d4eee73e2547cd786fe8e8a4

# 10 is best for aggregate throughput, 16 for a single stream (+28%).
#DRAFT_TOKENS=10
# Concurrent requests. Sizes the GDN pool (x5) and decode CUDA graphs with it.
#MAX_RUNNING=32

# 0.85 measured fine under Docker, but earlyoom can kill the server at it.
#MEM_FRACTION=0.80

# 8192 favours prefill throughput; the cookbook's 2048 favours smooth decode
# under mixed load.
#CHUNKED_PREFILL=8192
# 1 = prefill CUDA graphs on (the cookbook's cell); 0 = off, as measured here.
#PREFILL_CUDA_GRAPH=0

#CONTEXT_LENGTH=262144
#PORT=8888
#HOST=0.0.0.0
#SERVED_MODEL_NAME=qwen3.8-27b-sglang
# Set when the port is reachable beyond this machine.
#API_KEY=
# Empty = no CPU pinning.
#CPUSET=5-9,15-19

# Extra SGLang flags, appended last (they override the ones above).
#EXTRA_ARGS=

# Where the venv lives (default ~/spark, i.e. ~/spark/venv).
#GB10_WORKDIR=
